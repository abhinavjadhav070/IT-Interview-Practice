# InterviewX AI Student Platform - Environment Configuration

# Optional: Add your Google Gemini API key to switch from Local Cognitive Engine to Live Cloud Gemini
GEMINI_API_KEY=

# Optional: Or add your OpenAI API key
OPENAI_API_KEY=

# Judge0 Sandboxed Execution Host (Defaults to https://ce.judge0.com)
JUDGE0_API_HOST=https://ce.judge0.com
# Optional: RapidAPI Key if using RapidAPI Judge0
JUDGE0_API_KEY=

# Server Port
PORT=3000

# Optional comma-separated browser origins for a separately hosted frontend.
# The default allows the local app at http://localhost:${PORT}.
CORS_ALLOWED_ORIGINS=

# Public-facing app URL used in password-reset emails.
# Keep localhost for local development; use your real HTTPS origin in production.
APP_URL=http://localhost:3000

# Optional Resend email API. Email delivery stays disabled until the API key,
# verified sender, and support inbox are supplied. No secrets belong in git.
RESEND_API_KEY=
EMAIL_FROM=InterviewX <support@your-verified-domain.example>
SUPPORT_EMAIL=
